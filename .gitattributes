# Normalize line endings: LF in the repository, native in your working copy.
# Without this, a repo shared between Windows and Linux gets spurious
# whole-file diffs the first time someone on the other OS touches a file.
* text=auto

# Windows scripts must keep CRLF to run correctly.
*.bat text eol=crlf

# Shell scripts must keep LF, even when checked out on Windows.
*.sh text eol=lf
